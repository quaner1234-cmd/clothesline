<Window x:Class="Clothesline.OcrTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别文字"
        Width="600" Height="520"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Topmost="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="18" ShadowDepth="1" Opacity="0.16" Color="#241C1C1C"/>
        <DropShadowEffect x:Key="GlassShadowHover" BlurRadius="28" ShadowDepth="4" Opacity="0.28" Color="#3A1C1C1C"/>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2C343A"/>
            <Setter Property="Background" Value="#EEF4F7"/>
            <Setter Property="BorderBrush" Value="#D5DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B7C3CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="Foreground" Value="#5C656C"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border CornerRadius="16" BorderThickness="1" Padding="18,14,18,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#C9F7F4EF"/>
                    <Setter Property="BorderBrush" Value="#F2FFFFFF"/>
                    <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect" Value="{StaticResource GlassShadowHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll" Margin="0,0,0,12">
                    <TextBlock Text="识别文字" FontSize="15" FontWeight="SemiBold" Foreground="#2C343A"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#5C656C" FontSize="13"
                           LineHeight="20" Margin="0,0,0,12"
                           Text="选中一部分再点复制或翻译。没有选中时，两个按钮都用全文。识别结果不会自动进剪贴板。"/>
                <Border Grid.Row="2" CornerRadius="12" Background="#F7FFFFFF" BorderBrush="#E4FFFFFF"
                        BorderThickness="1" Padding="2">
                    <TextBox x:Name="Body" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="12,10"
                             FontSize="15" Foreground="#2C343A" CaretBrush="#5C656C"/>
                </Border>
                <TextBlock x:Name="Status" Grid.Row="3" Margin="2,10,0,10" MinHeight="18"
                           FontSize="12" Foreground="#5C656C" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="Copy_Click"/>
                    <Button Content="翻译" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="Translate_Click"/>
                    <Button Content="关闭" Style="{StaticResource QuietButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,8,8" Cursor="SizeNWSE" DragDelta="Sizer_Drag">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="5" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F7F9FB" Offset="0"/>
                                <GradientStop Color="#C5CED6" Offset="0.55"/>
                                <GradientStop Color="#9AA4AD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#7E888F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
