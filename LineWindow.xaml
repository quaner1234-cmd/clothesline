<Window x:Class="Clothesline.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clothesline"
        Title="Clothesline"
        Width="1280" Height="{x:Static local:PegZoom.DefaultLineHeight}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True"
        Left="0" Top="0">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="1" Opacity="0.16" Color="#241C1C1C"/>
        <DropShadowEffect x:Key="CardShadowHover" BlurRadius="28" ShadowDepth="5" Opacity="0.32" Color="#3A1C1C1C"/>
    </Window.Resources>
    <!-- alpha=1 而不是全透明：分层窗口按像素 alpha 做鼠标命中，全透明会被系统穿透 -->
    <Grid x:Name="Root" Background="#01000000" MouseLeftButtonDown="Root_MouseDown">
        <!-- 注意：Root 不能挂 RenderTransform——会让 AllowsTransparency 分层窗口整块变白 -->
        <Grid x:Name="RopeHost" VerticalAlignment="Top" IsHitTestVisible="False">
        <Path x:Name="RopeShadow" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00606870" Offset="0"/>
                    <GradientStop Color="#55606870" Offset="0.07"/>
                    <GradientStop Color="#55606870" Offset="0.93"/>
                    <GradientStop Color="#00606870" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.Effect>
                <BlurEffect Radius="3"/>
            </Path.Effect>
        </Path>
        <Path x:Name="RopeHighlight" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Top" Margin="0,-0.7,0,0" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#E6FFFFFF" Offset="0.08"/>
                    <GradientStop Color="#E6FFFFFF" Offset="0.92"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
        <Path x:Name="RopeCore" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Top" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00A7B0B8" Offset="0"/>
                    <GradientStop Color="#FFA7B0B8" Offset="0.05"/>
                    <GradientStop Color="#FFA7B0B8" Offset="0.95"/>
                    <GradientStop Color="#00A7B0B8" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
        </Grid>
        <ScrollViewer x:Name="PegScroll"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Focusable="False"
                      PreviewMouseWheel="PegScroll_PreviewMouseWheel">
            <ItemsControl x:Name="Pegs" VerticalAlignment="Top" HorizontalAlignment="Left"
                          Margin="12,0,18,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="22,0,0,0" Background="Transparent" VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0" RenderTransform="{Binding Xf}"
                          Loaded="Peg_Loaded"
                          MouseEnter="Peg_MouseEnter" MouseLeave="Peg_MouseLeave">
                        <Border Margin="0,18,0,8" CornerRadius="16" Padding="8" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#C9F7F4EF"/>
                                    <Setter Property="BorderBrush" Value="#F2FFFFFF"/>
                                    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                            <Setter Property="Effect" Value="{StaticResource CardShadowHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Bitmap}" Stretch="Uniform"
                                   Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}"
                                   Cursor="Hand"
                                   PreviewMouseLeftButtonDown="Peg_MouseDown"
                                   PreviewMouseMove="Peg_MouseMove"
                                   PreviewMouseLeftButtonUp="Peg_MouseUp"
                                   MouseRightButtonDown="Peg_RightDown"/>
                        </Border>
                        <Grid Width="9" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border CornerRadius="4.5" Background="#33000000" Margin="0.8,1.2,0,0"/>
                            <Border CornerRadius="4.5" BorderThickness="0.6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F7F9FB" Offset="0"/>
                                        <GradientStop Color="#C5CED6" Offset="0.42"/>
                                        <GradientStop Color="#F3F6F8" Offset="0.58"/>
                                        <GradientStop Color="#9AA4AD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#7E888F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Ellipse Width="5" Height="3.2" Fill="#5C656C" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            </Border>
                        </Grid>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                CornerRadius="10" Background="#E8F7F4EF" BorderBrush="#F2FFFFFF" BorderThickness="1"
                                Padding="10,3" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18" Color="#1C1C1C"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopyFeedback}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="已复制" FontSize="12" Foreground="#3E474E"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
